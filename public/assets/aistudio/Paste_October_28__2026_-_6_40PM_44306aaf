    <script>
        // Sidebar Toggle for Mobile
        const sidebar = document.getElementById('sidebar');
        const openBtn = document.getElementById('open-sidebar');
        const closeBtn = document.getElementById('close-sidebar');

        openBtn.addEventListener('click', () => {
            sidebar.classList.remove('-translate-x-full');
            sidebar.classList.add('translate-x-0', 'absolute');
            sidebar.style.display = 'flex';
        });

        closeBtn.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
            setTimeout(() => {
                if (window.innerWidth < 768) {
                    sidebar.style.display = 'none';
                }
            }, 300);
        });

        // Close sidebar on link click (mobile)
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 768) {
                    sidebar.classList.add('-translate-x-full');
                    setTimeout(() => { sidebar.style.display = 'none'; }, 300);
                }
            });
        });

        // Toast Notification System (NO ALERTS)
        function showToast(message, isSuccess = true) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            
            toast.classList.remove('hidden');
            // Trigger reflow
            void toast.offsetWidth;
            
            toast.classList.remove('opacity-0', 'translate-y-full');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-full');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 3000);
        }

        // Copy HTML Code Function
        function copyCode() {
            const htmlContent = document.documentElement.outerHTML;
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(htmlContent).then(() => {
                    showToast("¡Código HTML copiado al portapapeles exitosamente!");
                }).catch(err => {
                    fallbackCopyTextToClipboard(htmlContent, "Código HTML");
                });
            } else {
                fallbackCopyTextToClipboard(htmlContent, "Código HTML");
            }
        }

        // Copy plain text content Function
        function copyText() {
            const docContent = document.getElementById('document-text').innerText;
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(docContent).then(() => {
                    showToast("¡Texto del documento copiado al portapapeles!");
                }).catch(err => {
                    fallbackCopyTextToClipboard(docContent, "Texto del documento");
                });
            } else {
                fallbackCopyTextToClipboard(docContent, "Texto del documento");
            }
        }

        // Fallback for older browsers or non-secure contexts
        function fallbackCopyTextToClipboard(text, typeName) {
            var textArea = document.createElement("textarea");
            textArea.value = text;
            // Prevent scrolling to bottom
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.position = "fixed";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                var successful = document.execCommand('copy');
                if(successful) {
                    showToast(`¡${typeName} copiado al portapapeles!`);
                } else {
                    showToast(`No se pudo copiar el ${typeName.toLowerCase()}.`, false);
                }
            } catch (err) {
                showToast(`Error al intentar copiar el ${typeName.toLowerCase()}.`, false);
            }
            document.body.removeChild(textArea);
        }

        // Smooth Scrollspy for sidebar
        const mainContent = document.getElementById('main-content');
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-link');

        mainContent.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (mainContent.scrollTop >= sectionTop - 100) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('bg-white/20', 'text-white');
                if (link.getAttribute('href').includes(current) && current !== '') {
                    link.classList.add('bg-white/20', 'text-white');
                }
            });
        });
        
        // Handle window resize for sidebar
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) {
                sidebar.style.display = 'flex';
                sidebar.classList.remove('-translate-x-full', 'absolute');
            } else {
                sidebar.classList.add('-translate-x-full', 'absolute');
                setTimeout(() => { if(window.innerWidth < 768) sidebar.style.display = 'none'; }, 300);
            }
        });
    </script>

